# URL API Strapi (тот же хост/порт, что и `npm run develop` в папке strapi/)
# Достаточно одного из STRAPI_URL или NEXT_PUBLIC_STRAPI_URL
STRAPI_URL=http://127.0.0.1:1337
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337

# Токен API (если в Strapi отключён публичный find / используется draft)
# STRAPI_API_TOKEN=
