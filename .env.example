# Payload CMS (обязательно). Без PAYLOAD_SECRET /admin отдаёт 500.
# Скопируйте в `.env` или `.env.local`. Для продакшена замените на случайную строку (≥ 32 символов).
PAYLOAD_SECRET=change_me_to_a_long_random_string_at_least_32_chars_ok

# --- База данных ---
# Локально по умолчанию: file:./payload.sqlite (DATABASE_URI можно не задавать).
#
# Vercel + Turso (рекомендуется для продакшена — данные Admin сохраняются):
#   DATABASE_URI=libsql://your-db-name-org.turso.io
#   DATABASE_AUTH_TOKEN=eyJhbG…
# Получить URL:  turso db show <имя-бд> --url
# Создать токен: turso db tokens create <имя-бд>
# Первичная настройка: npm run turso:setup
#
# Без Turso на Vercel используется эфемерная копия data/payload.seed.sqlite в /tmp
# (изменения в Admin, в т.ч. MCP API keys, не сохраняются между cold start).
# DATABASE_URI=file:./payload.sqlite

# Токен Turso (обязателен, если DATABASE_URI начинается с libsql:// или https://)
# DATABASE_AUTH_TOKEN=

# Storybook (портал рендерит те же stories; ссылка «открыть в Storybook»)
NEXT_PUBLIC_STORYBOOK_URL=http://127.0.0.1:6006

# Базовый URL портала для абсолютных ссылок (OG share, Markdown, media).
# Localhost: превью в мессенджерах не работает.
# Vercel: https://your-app.vercel.app
# Dev через туннель: https://xxxx.ngrok-free.app
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
