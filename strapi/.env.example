# Скопируйте в `.env` и заполните случайными строками (32+ символов).
# Либо один раз скопируйте из сгенерированного локального `.env`.

HOST=0.0.0.0
PORT=1337

# Обязательные секреты Strapi 5 (админка, сессии, токены)
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Несколько ключей через запятую (без пробелов)
APP_KEYS=key1,key2,key3,key4

# Опционально (см. strapi/src/bootstrap/)
# STRAPI_SEED_DEMO=true
# STRAPI_GRANT_PUBLIC_READ=true
