{
  "kind": "collectionType",
  "collectionName": "components",
  "info": {
    "singularName": "component",
    "pluralName": "components",
    "displayName": "Component"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "figmaUrl": {
      "type": "string"
    },
    "storybookUrl": {
      "type": "string"
    },
    "docsUrl": {
      "type": "string"
    },
    "componentGroup": {
      "type": "enumeration",
      "enum": ["data_display", "feedback", "inputs", "layout", "navigation"],
      "default": "layout",
      "required": false
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::component.component",
      "inversedBy": "children"
    },
    "children": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::component.component",
      "mappedBy": "parent"
    }
  }
}
