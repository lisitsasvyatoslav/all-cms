# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (включая вложенные пакеты)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js (включая вложенные app-пакеты)
.next/
out/
.swc/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# Cursor: локальный MCP с Bearer-ключом Payload (шаблон — .cursor/mcp.payload.example.json)
.cursor/mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Payload (local SQLite trial)
/payload.sqlite
/payload.sqlite-shm
/payload.sqlite-wal
/media

# Astro / Vite artifacts in subprojects
**/.astro/
