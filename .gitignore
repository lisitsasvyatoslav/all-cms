# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (любая глубина вложенности)
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
**/coverage/

# next.js (включая вложенные app-пакеты)
.next/
out/
.swc/

# production
/build

# misc
.DS_Store
*.pem
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# caches / tooling
.cache/
.turbo/
.parcel-cache/
**/storybook-static/
**/test-results/
**/playwright-report/
public/_pagefind/

# Payload (local SQLite trial)
/payload.sqlite
/payload.sqlite-shm
/payload.sqlite-wal
/media

# Astro / Vite artifacts in subprojects
**/.astro/
**/dist/
**/.vite/

# Sanity Studio local state
.sanity/
