# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root + nested e.g. strapi/)
node_modules/

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — секреты не коммитим; *.example исключены
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tooling caches
.turbo
.eslintcache

# Strapi (nested app)
strapi/.tmp/
strapi/.cache/
strapi/build/
strapi/dist/
strapi/.strapi-updater.json
strapi/.strapi/
strapi/public/uploads/
