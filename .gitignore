# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (включая вложенные пакеты)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.swc/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — шаблоны можно коммитить (в т.ч. во вложенных пакетах)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# кэши инструментов
.turbo
.eslintcache
/.cache/

# поиск (если подключите Pagefind и вывод в public)
public/_pagefind/

# e2e / storybook (если появятся в проекте)
/test-results/
/playwright-report/
blob-report/
storybook-static/

# IDE — локальные настройки (общие конфиги коммитьте осознанно)
.idea/

# legacy / локальные артефакты
/payload.sqlite
/media

