# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (включая вложенные пакеты)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — шаблоны можно коммитить (в т.ч. во вложенных пакетах)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# кэши инструментов
.turbo
.eslintcache

# legacy / локальные артефакты
/payload.sqlite
/media

# Astro CMS (подпроект)
astro-cms/dist/
astro-cms/.astro/
