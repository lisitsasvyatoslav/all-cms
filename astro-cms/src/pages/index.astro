---
import { getCollection } from "astro:content";

const components = await getCollection("components");
const colors = await getCollection("colors");
const icons = await getCollection("icons");
const portal = await getCollection("portalSources");
const sources = portal[0]?.data;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Портал контента · Astro CMS</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 42rem;
        margin: 0 auto;
        padding: 2rem;
        line-height: 1.5;
      }
      code {
        background: #f4f4f5;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.9em;
      }
      ul {
        padding-left: 1.25rem;
      }
      .muted {
        color: #71717a;
        font-size: 0.9rem;
      }
    </style>
  </head>
  <body>
    <h1>Astro Content Collections</h1>
    <p class="muted">
      Данные из той же папки <code>content/</code>, что использует Next-портал (<code
        >npm run dev</code
      >
      в корне). Здесь — предпросмотр и проверка схем при <code>astro build</code>.
    </p>

    <h2>Источники (portal-sources.json)</h2>
    <ul>
      {
        sources?.figmaLibraryUrl && (
          <li>
            <a href={sources.figmaLibraryUrl}>Figma</a>
          </li>
        )
      }
      {
        sources?.storybookUrl && (
          <li>
            <a href={sources.storybookUrl}>Storybook</a>
          </li>
        )
      }
      {
        sources?.documentationUrl && (
          <li>
            <a href={sources.documentationUrl}>Документация</a>
          </li>
        )
      }
      {
        sources?.repositoryUrl && (
          <li>
            <a href={sources.repositoryUrl}>Репозиторий</a>
          </li>
        )
      }
    </ul>

    <h2>Компоненты ({components.length})</h2>
    <ul>
      {
        components.map((c) => (
          <li>
            <strong>{c.data.name}</strong> — <code>{c.data.slug}</code>
          </li>
        ))
      }
    </ul>

    <h2>Цвета ({colors.length})</h2>
    <ul>
      {
        colors.map((c) => (
          <li>
            {c.data.name}{" "}
            <span style={`color: ${c.data.hex}`}>■</span>{" "}
            <code>{c.data.hex}</code>
          </li>
        ))
      }
    </ul>

    <h2>Иконки ({icons.length})</h2>
    <ul>
      {
        icons.map((i) => (
          <li>
            {i.data.name}
            {i.data.slug ? (
              <>
                {" "}
                — <code>{i.data.slug}</code>
              </>
            ) : null}
          </li>
        ))
      }
    </ul>

    <p class="muted">
      Основной UI портала: Next на <code>http://localhost:3000</code>. Этот Astro —
      <code>http://localhost:4321</code>.
    </p>
  </body>
</html>
